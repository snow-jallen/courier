<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <EnableDefaultAvaloniaItems>true</EnableDefaultAvaloniaItems>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/courier.ico</ApplicationIcon>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
    <Version>1.0.0</Version>
    <Product>Courier</Product>
    <Company>Courier</Company>

    <!-- Published as a folder, not a single file: Velopack packages that folder into
         an installer and replaces it wholesale when updating, and cannot do either to a
         self-extracting executable. Not trimmed either — EF Core builds its model by
         reflection the trimmer cannot see, and a trimmed build fails at run time rather
         than at build time. -->
    <SelfContained>true</SelfContained>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="courier-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Courier.Core\Courier.Core.csproj" />
    <ProjectReference Include="..\Courier.Data\Courier.Data.csproj" />
    <ProjectReference Include="..\Courier.Messaging\Courier.Messaging.csproj" />
  </ItemGroup>
</Project>
