<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Courier.App.ViewModels"
        xmlns:views="using:Courier.App.Views"
        x:Class="Courier.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Courier" Width="1140" Height="740" MinWidth="820" MinHeight="560"
        Background="{DynamicResource Ground}">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:ImportViewModel">
      <views:ImportView/>
    </DataTemplate>
    <DataTemplate DataType="vm:PeopleViewModel">
      <views:PeopleView/>
    </DataTemplate>
    <DataTemplate DataType="vm:SendViewModel">
      <views:SendView/>
    </DataTemplate>
    <DataTemplate DataType="vm:LcrBacklogViewModel">
      <views:LcrBacklogView/>
    </DataTemplate>
    <DataTemplate DataType="vm:HistoryViewModel">
      <views:HistoryView/>
    </DataTemplate>
    <DataTemplate DataType="vm:SetupViewModel">
      <views:SetupView/>
    </DataTemplate>
    <DataTemplate DataType="vm:ScreenFailedViewModel">
      <StackPanel Margin="28,26" Spacing="10">
        <TextBlock Classes="h2" Text="That screen could not be opened"/>
        <Border Classes="notice privacy" HorizontalAlignment="Left">
          <TextBlock Text="{Binding Message}" FontSize="12.5" TextWrapping="Wrap" MaxWidth="640"
                     Foreground="{DynamicResource Ink2}"/>
        </Border>
        <TextBlock Classes="lede" Text="Nothing has been changed. Try another screen, or restart Courier."/>
      </StackPanel>
    </DataTemplate>
  </Window.DataTemplates>

  <Grid ColumnDefinitions="216,*">

    <!-- Navigation rail -->
    <Border Grid.Column="0" Background="{DynamicResource Surface2}"
            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="10,14">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="9" Margin="6,0,6,16">
          <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource Accent}">
            <TextBlock Text="C" FontSize="15" FontWeight="Bold"
                       Foreground="{DynamicResource OnAccent}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Courier" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource Ink}"/>
            <TextBlock Text="{Binding SenderLabel}" FontSize="9" LetterSpacing="0.6"
                       FontWeight="SemiBold" Foreground="{DynamicResource Ink3}"
                       TextWrapping="Wrap" MaxWidth="150"/>
          </StackPanel>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,1,0,0" Padding="6,10,6,0" Margin="0,10,0,0">
          <StackPanel Spacing="2">
            <TextBlock Text="Your directory" FontSize="11.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource Ink2}"/>
            <TextBlock Text="{Binding DatabaseLabel}" Classes="mono" FontSize="10.5"
                       Foreground="{DynamicResource Ink3}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <StackPanel Spacing="2">
          <RadioButton Classes="nav" GroupName="nav" IsChecked="True" Content="Import"
                       Click="OnImport"/>
          <RadioButton Classes="nav" GroupName="nav" Content="People" Click="OnPeople"/>
          <RadioButton Classes="nav" GroupName="nav" Content="Send a message" Click="OnSend"/>
          <RadioButton Classes="nav" GroupName="nav" Content="To enter in LCR" Click="OnLcr"/>
          <RadioButton Classes="nav" GroupName="nav" Content="What you have sent" Click="OnHistory"/>
          <RadioButton Classes="nav" GroupName="nav" Content="Setup" Click="OnSetup"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <ContentControl Grid.Column="1" Content="{Binding Current}"/>
  </Grid>
</Window>
