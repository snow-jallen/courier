<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Courier.App.ViewModels"
             x:Class="Courier.App.Views.PeopleView"
             x:DataType="vm:PeopleViewModel">

  <Grid Margin="28,26,28,24" RowDefinitions="Auto,Auto,Auto,*,Auto">
    <StackPanel Grid.Row="0">
    <TextBlock Classes="h2" Text="People"/>
    <TextBlock Classes="lede" Margin="0,4,0,0"
               Text="Choose how each person prefers to hear from you. That choice is yours, not LCR's — importing again never resets it."/>
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,18,0,12" ColumnSpacing="9">
      <TextBox Grid.Column="0" PlaceholderText="Search a name, email or phone"
               Text="{Binding Search}"/>
      <ComboBox Grid.Column="1" MinWidth="170"
                ItemsSource="{Binding WardOptions}" SelectedItem="{Binding Ward}"/>
    </Grid>

    <Border Grid.Row="3" Classes="card" Padding="0" ClipToBounds="True">
      <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Classes="header">
          <Grid ColumnDefinitions="2*,1.4*,2*,1.3*,0.5*,0.8*,Auto">
            <Button Grid.Column="0" Classes="sortable" Content="NAME"
                    Command="{Binding SortByCommand}" CommandParameter="name"/>
            <Button Grid.Column="1" Classes="sortable" Content="WARD"
                    Command="{Binding SortByCommand}" CommandParameter="ward"/>
            <TextBlock Grid.Column="2" Classes="colhead" Text="EMAIL"/>
            <TextBlock Grid.Column="3" Classes="colhead" Text="PHONE"/>
            <Button Grid.Column="4" Classes="sortable" Content="AGE"
                    Command="{Binding SortByCommand}" CommandParameter="age"/>
            <Button Grid.Column="5" Classes="sortable" Content="BIRTHDAY"
                    Command="{Binding SortByCommand}" CommandParameter="birthday"/>
            <Button Grid.Column="6" Classes="sortable" Content="PREFERS" Width="168"
                    Command="{Binding SortByCommand}" CommandParameter="channel"/>
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Name="PeopleScroller"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PersonRow">
                <Border Classes="row">
                  <Grid ColumnDefinitions="2*,1.4*,2*,1.3*,0.5*,0.8*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Ward}" Foreground="{DynamicResource Ink3}"
                               FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Email}" Classes="mono"
                               Foreground="{DynamicResource Ink2}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding Phone}" Classes="mono"
                               Foreground="{DynamicResource Ink2}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="{Binding Age}" Classes="mono"
                               Foreground="{DynamicResource Ink2}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="{Binding Birthday}" Classes="mono"
                               Foreground="{DynamicResource Ink3}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="6" Orientation="Horizontal" Width="168">
                      <Button Classes="chip first email" Classes.on="{Binding IsEmail}"
                              Content="Email" Command="{Binding ChooseEmailCommand}"/>
                      <Button Classes="chip text" Classes.on="{Binding IsText}"
                              Content="Text" Command="{Binding ChooseTextCommand}"/>
                      <Button Classes="chip last voice" Classes.on="{Binding IsVoice}"
                              Content="Voice" Command="{Binding ChooseVoiceCommand}"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <StackPanel Grid.Row="4" Margin="0,9,0,0">
      <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{DynamicResource Ink3}"/>
      <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource Ink3}" TextWrapping="Wrap"
                 Text="Click the channel already chosen to clear it. People who have fallen out of the export are hidden here."/>
    </StackPanel>
  </Grid>
</UserControl>
